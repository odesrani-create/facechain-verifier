# ==========================================
# FaceChain Verifier Configuration
# ==========================================

PROJECT_NAME=FaceChain Verifier
DEBUG=false


# ==========================================
# Search
# ==========================================

# Currently supported:
# serpapi

SEARCH_PROVIDER=serpapi

SERPAPI_API_KEY=


# ==========================================
# Image Server
# ==========================================

IMAGE_SERVER_PORT=8000

# Optional.
# Used when the image is publicly accessible.
PUBLIC_IMAGE_URL=


# ==========================================
# Blockchain
# ==========================================

# Currently:
# local

BLOCKCHAIN_PROVIDER=local

# Required for external blockchain providers.
BLOCKCHAIN_RPC_URL=

# NEVER commit your real private key.
BLOCKCHAIN_PRIVATE_KEY=
